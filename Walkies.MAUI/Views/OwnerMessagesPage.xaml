<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Walkies.MAUI.ViewModels"
             xmlns:views="clr-namespace:Walkies.MAUI.Views"
             xmlns:models="clr-namespace:Walkies.MAUI.Models"
             x:Class="Walkies.MAUI.Views.OwnerMessagesPage"
             x:DataType="vm:MessagingViewModel"
             Title="Messages">
    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="32" Spacing="16">
                <Label Text="Messages" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage}"
                       FontSize="13" />
                <Label Text="No messages" TextColor="Gray" IsVisible="{Binding NoMessages}"
                       FontSize="13" />
                <CollectionView ItemsSource="{Binding Messages}">
                   <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MessageModel">
                            <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,4">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontSize="13" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SenderName}" />
                                                <Span Text="->" />
                                                <Span Text="{Binding RecipientName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Content}" FontSize="14" />
                                    <Label Text="{Binding SentAt, StringFormat='{0:dd MMM yyyy HH:mm}'}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Label Text="Send To" FontAttributes="Bold" Margin="16,8,16,0" />
        <Picker ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" ItemDisplayBinding="{Binding RecipientName}"
                Title="Select a contact" Margin="16,0" />
        <!-- Compose message area -->
        <Grid Grid.Row="1" Padding="16" ColumnDefinitions="*, Auto" BackgroundColor="{StaticResource Gray100}">
            <Entry Grid.Column="0" Text="{Binding NewMessage}" Placeholder="Type new message..." VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Send" Command="{Binding SendMessagesCommand}" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</views:BasePage>