<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Walkies.MAUI.ViewModels"
             xmlns:views="clr-namespace:Walkies.MAUI.Views"
             x:Class="Walkies.MAUI.Views.OwnerDashboardPage"
             x:DataType="vm:OwnerDashboardViewModel"
             Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">
            <Label Text="Walkies" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Label FontSize="20" HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome, " />
                        <Span Text="{Binding FirstName}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="Owner Dashboard" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />
            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" FontSize="13" />
            
            <!-- Navigation -->
            <Button Text="My Profile" Command="{Binding NavigateToProfileCommand}" />
            <Button Text="My Dogs" Command="{Binding NavigateToMyDogsCommand}" />
            <Button Text="Logout" Command="{Binding LogoutCommand}" BackgroundColor="Red" Margin="0,16,0,0" />
            <Button Text="Post Walk Request" Command="{Binding NavigateToPostWalkRequestCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>