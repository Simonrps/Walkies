<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Walkies.MAUI.ViewModels"
             xmlns:models="clr-namespace:Walkies.MAUI.Models"
             xmlns:views="clr-namespace:Walkies.MAUI.Views"
             x:Class="Walkies.MAUI.Views.WalkerCheckInPage"
             x:DataType="vm:BookingViewModel"
             Title="My Walks">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" MaximumWidthRequest="500">
            <Label Text="My Walks" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"
               TextColor="{StaticResource Primary}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" FontSize="13" />
            <Label Text="You have no assigned walks" FontSize="13" TextColor="Gray" IsVisible="{Binding NoBookings}" />
            <CollectionView ItemsSource="{Binding Bookings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BookingModel">
                        <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding DogName}" FontAttributes="Bold" FontSize="16"/>
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Owner: " FontAttributes="Bold"/>
                                            <Span Text="{Binding OwnerName}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Date: " FontAttributes="Bold"/>
                                            <Span Text="{Binding ScheduledDate, StringFormat='{0:dd MMM yyyy}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Location: " FontAttributes="Bold"/>
                                            <Span Text="{Binding Location}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Status: " FontAttributes="Bold"/>
                                            <Span Text="{Binding Status}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Button Text="Check In" FontSize="12" IsVisible="{Binding Status, Converter={StaticResource
                                    StringEqualsConverter}, ConverterParameter=Confirmed}" Command="{Binding Source={RelativeSource
                                    AncestorType={x:Type vm:BookingViewModel}}, Path=CheckInCommand}" CommandParameter="{Binding .}" />
                                <Button Text="Check Out" FontSize="12" IsVisible="{Binding Status, Converter={StaticResource
                                    StringEqualsConverter}, ConverterParameter=Active}" Command="{Binding Source={RelativeSource
                                    AncestorType={x:Type vm:BookingViewModel}}, Path=CheckOutCommand}" CommandParameter="{Binding .}" />
                                <Button Text="Cancel Booking" FontSize="12" IsVisible="{Binding Status, Converter={StaticResource
                                    StringEqualsConverter}, ConverterParameter=Confirmed}" Command="{Binding Source={RelativeSource
                                    AncestorType={x:Type vm:BookingViewModel}}, Path=CancelBookingCommand}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>