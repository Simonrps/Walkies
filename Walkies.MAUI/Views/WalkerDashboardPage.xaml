<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Walkies.MAUI.ViewModels"
             xmlns:views="clr-namespace:Walkies.MAUI.Views"
             x:Class="Walkies.MAUI.Views.WalkerDashboardPage"
             x:DataType="vm:WalkerDashboardViewModel"
             Title="WalkerDashboardPage">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" MaximumWidthRequest="500">
            <Label Text="Walkies" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Label FontSize="20" HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome, " />
                        <Span Text="{Binding FirstName}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="Walker Dashboard" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />
            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" FontSize="13" />
            <Button Text="My Profile" Command="{Binding NavigateToProfileCommand}" />
            <Button Text="My Availability" Command="{Binding NavigateToAvailabilityCommand}" />
            <Button Text="Find Walk Requests" Command="{Binding NavigateToSearchRequestsCommand}" />
            <Button Text="My Bookings" Command="{Binding NavigateToMyWalksCommand}" />
            <Button Text="Messages" Command="{Binding NavigateToMessagesCommand}" />
            <Button Text="Payment Confirmation" Command="{Binding NavigateToPaymentsCommand}" />
            <Button Text="Logout" Command="{Binding LogoutCommand}" BackgroundColor="Red" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>