<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Walkies.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Walkies.MAUI.Views"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <ShellContent Title="Register" ContentTemplate="{DataTemplate views:RegisterPage}"
                  Route="register" />
    <ShellContent Title="Login" ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="login" />
</Shell>
