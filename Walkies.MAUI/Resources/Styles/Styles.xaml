<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page background responds to dark/light mode -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground},
                Dark={StaticResource DarkBackground}}" />
    </Style>

    <!-- Primary button -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- Danger button - logout, cancel, delete -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}" />
    </Style>

    <!-- Small action button inside list cards -->
    <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- Danger variant of small card button -->
    <Style x:Key="CardActionDangerButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}" />
    </Style>

    <!-- Entry fields - BackgroundColour only: height is controlled by EntryBrderStyle -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
                Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Entry border style that wraps each Entry to enfore consistent height across platforms -->
    <Style x:Key="EntryBorderStyle" TargetType="Border">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
                Dark={StaticResource DarkSecondaryBackground}}" />
    </Style>

    <!-- Picker fields -->
    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
            Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
                Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- DatePicker fields matches picker style -->
    <Style TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
        Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
            Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- Standard label -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
            Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Border style for list items -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White},
                Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="Stroke" Value="{StaticResource Gray300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
</ResourceDictionary>